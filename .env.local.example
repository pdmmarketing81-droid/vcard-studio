# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Server-only. NEVER expose this to the browser / never commit it.
# Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# ---- App ----
# The domain your app is hosted on (no protocol). Used to detect custom domains.
NEXT_PUBLIC_APP_DOMAIN=vcard-studio.vercel.app

# Password for the /admin panel (simple gate for the internal-tool phase)
ADMIN_PASSWORD=change-me-please
