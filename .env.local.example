# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Server-only. NEVER expose this to the browser / never commit it.
# Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# ---- App ----
# The domain your app is hosted on (no protocol). Used to detect custom domains.
NEXT_PUBLIC_APP_DOMAIN=vcard-studio.vercel.app

# Password for the /admin panel (simple gate for the internal-tool phase)
# Keep it letters and numbers only — a '#' in a .env file starts a comment
# and silently truncates the value.
ADMIN_PASSWORD=changemeplease

# ---- Outbound mail (Hostinger mailbox) ----
# Private review feedback is emailed to the client from this address.
# Never send *as* the client's domain — SPF/DKIM would fail and it'd go to spam.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@pdmmarketing.in
SMTP_PASS=your-mailbox-password
SMTP_FROM="vCard Studio <noreply@pdmmarketing.in>"
